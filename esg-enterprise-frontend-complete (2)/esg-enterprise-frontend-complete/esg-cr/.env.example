# ==============================================================================
# ESG Policy Intelligence Backend (Member 2) - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# LLM Provider: 'gemini' or 'openai' (default: gemini)
LLM_PROVIDER=gemini

# Gemini API Key (required for LLM commitment extraction and AI recommendations):
# Obtain key at: https://aistudio.google.com/apikey
# If empty, deterministic regex extraction and rule-based recommendations are used.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional Hugging Face Token (for alternative recommendation generation):
HUGGINGFACE_API_KEY=
