# ==============================================================================
# AI-Powered Enterprise ESG Sustainability Platform - Backend Configuration
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Security Configuration (Member 5)
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'staging', or 'production'
# In production, SECRET_KEY MUST be at least 32 characters long.
ENVIRONMENT=development

# JWT Secret Key: Required in production mode (must be >= 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-32-character-or-longer-secret-key-for-jwt

# JWT Algorithm and Token Expiry
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. Database Configuration (Member 5 & Member 3)
# ------------------------------------------------------------------------------
# Platform Database URL:
#   SQLite (default development): sqlite:///platform_db/platform.db
#   PostgreSQL (production):      postgresql://user:password@localhost:5432/esg_platform
DATABASE_URL=sqlite:///platform_db/platform.db

# Green Software Intelligence Database:
#   SQLite (default development): sqlite:///green_db/green_code.db
GREEN_DB_PATH=green_db/green_code.db

# ------------------------------------------------------------------------------
# 3. Inter-Service Microservice Routing (Member 5 -> Member 2)
# ------------------------------------------------------------------------------
# URL of Member 2's Policy Intelligence Backend
MEMBER2_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. AI & Cloud Intelligence Provider Keys (Members 1, 2, 3, 4)
# ------------------------------------------------------------------------------
# Google Gemini API Key:
# Used by:
#   - Member 1: RAG ESG document extraction & analysis
#   - Member 2: Policy commitment fallback parsing & recommendations
#   - Member 3: Green Code sustainability impact explanation
#   - Member 4: Cloud carbon anomaly remediation recommendations
# Obtain key at: https://aistudio.google.com/apikey
# If omitted, deterministic fallbacks and mock demo modes are automatically activated.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional GitHub Personal Access Token (Member 3):
# If omitted, built-in demo mode is used for scanning Acme Global repositories.
GITHUB_TOKEN=

# Optional Hugging Face Token (Member 2):
# For remote Hugging Face inference on policy recommendations.
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# 5. File Upload & Storage Limits
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (default: 20MB = 20971520 bytes)
MAX_UPLOAD_SIZE_BYTES=20971520

